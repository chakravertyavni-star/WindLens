# Public Elexon Insights API. No API key is required.
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Delivery window for this assignment.
DELIVERY_START_DATE=2026-01-01
DELIVERY_END_DATE=2026-01-31

# Analytical assumption, not an official client cutoff.
# Interpreted in Europe/London on the calendar day before the settlement date.
DECISION_CUTOFF_LOCAL_TIME=09:20
DECISION_CUTOFF_TIMEZONE=Europe/London

# In-memory TTL (seconds) for raw Elexon FUELHH/WINDFOR payloads shared across API routes.
# Set to 0 to disable caching (always fetch). Default: 3600 (1 hour).
ELEXON_SOURCE_CACHE_TTL_SECONDS=3600

# Comma-separated browser origins for split frontend/API hosting. Use * for dev only.
# CORS_ALLOWED_ORIGINS=https://your-app.example.com
CORS_ALLOWED_ORIGINS=*

# Production API bind (Dockerfile uses 0.0.0.0:8001). Local dev scripts use 127.0.0.1.
