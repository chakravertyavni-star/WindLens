# Production build — set before `npm run build`.
#
# Same-origin (recommended with nginx / Cloudflare reverse proxy to API):
#   Leave empty so the browser calls /api on the site host.
# VITE_API_BASE_URL=
#
# Split hosting (static on CDN, API elsewhere):
# VITE_API_BASE_URL=https://your-windlens-api.example.com

VITE_API_BASE_URL=
